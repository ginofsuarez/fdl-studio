---
interface Props { href?: string; compact?: boolean }
const { href = '/', compact = false } = Astro.props;
---
<a href={href} class="logo" aria-label="FDL Studio">
  <img src="/brand/fdl-symbol-black.png" alt="" width="220" height="256" class="logo__img" />
  {!compact && (
    <span class="logo__text">
      <span class="logo__name">FDL Studio</span>
      <span class="logo__tag">Software Consultancy</span>
    </span>
  )}
</a>
<style>
  .logo { display: inline-flex; align-items: center; gap: var(--space-3); text-decoration: none; }
  .logo__img { width: auto; height: 2.5rem; }
  .logo__text { display: flex; flex-direction: column; line-height: 1; }
  .logo__name { font-family: var(--font-display); font-weight: 600; font-size: 1.05rem; color: var(--color-ink); }
  .logo__tag { font-size: 0.56rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-muted); margin-top: 0.3rem; }
</style>
