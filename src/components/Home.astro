---
import MapleLeaf from './MapleLeaf.astro';
import SectionHead from './SectionHead.astro';
import SocialLinks from './SocialLinks.astro';
import { home } from '../i18n/home';
import { site } from '../config/site';
import type { Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = home[lang];
// Highlight the closing punctuation of the hero title in the accent color.
const titleMatch = c.hero.title.match(/^(.*?)([.!?])?$/s)!;
const offices = site.offices.map((o) => ({ ...o, countryName: o.country[lang] }));
---

<!-- Hero -->
<section class="hero">
  <MapleLeaf class="hero__leaf" />
  <div class="container relative-content hero__inner">
    <p class="eyebrow">{c.hero.eyebrow}</p>
    <h1 class="display hero__title">{titleMatch[1]}{titleMatch[2] && <span class="accent">{titleMatch[2]}</span>}</h1>
    <p class="lead">{c.hero.lead}</p>
    <div class="hero__actions">
      <a class="btn btn--primary" href="#contact">{c.hero.primary} <span class="arrow" aria-hidden="true">→</span></a>
      <a class="btn btn--ghost" href="#services">{c.hero.secondary}</a>
    </div>
    <p class="hero__places caption">
      {offices.map((o, i) => <>{i > 0 && <span aria-hidden="true"> · </span>}{o.city}, {o.countryName}</>)}
    </p>
  </div>
</section>

<!-- 01 Services -->
<section class="section section--band" id="services" aria-labelledby="services-title">
  <div class="container">
    <SectionHead num="01" title={c.services.title} id="services-title">{c.services.intro}</SectionHead>
    <div class="grid grid--2 services">
      {c.services.items.map((s, i) => (
        <article class="card">
          <span class="card__code">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="h3">{s.title}</h3>
          <p class="muted">{s.text}</p>
          <ul class="card__list">{s.points.map((p) => <li>{p}</li>)}</ul>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- 02 Process -->
<section class="section" id="process" aria-labelledby="process-title">
  <div class="container">
    <SectionHead num="02" title={c.process.title} id="process-title">{c.process.intro}</SectionHead>
    <ol class="steps" style={`--steps:${c.process.steps.length}`}>
      {c.process.steps.map((s, i) => (
        <li class="step">
          <span class="step__dot" aria-hidden="true">{i + 1}</span>
          <p class="step__title">{s.title}</p>
          <p class="step__text">{s.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<!-- 03 Engagement models -->
<section class="section section--surface" aria-labelledby="models-title">
  <div class="container">
    <SectionHead num="03" title={c.models.title} id="models-title">{c.models.intro}</SectionHead>
    <div class="grid grid--3">
      {c.models.items.map((m) => (
        <article class="card">
          <h3 class="h3">{m.title}</h3>
          <p class="muted">{m.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- 04 Work (placeholder content) -->
<section class="section" id="work" aria-labelledby="work-title">
  <div class="container">
    <SectionHead num="04" title={c.work.title} id="work-title">{c.work.intro}</SectionHead>
    <!-- TODO: replace placeholders with approved client logos, case studies and testimonials -->
    <ul class="logos" role="list">
      {[1, 2, 3, 4].map(() => <li class="placeholder">{c.work.logo}</li>)}
    </ul>
    <div class="grid grid--2 work">
      <article class="placeholder placeholder--block">
        <p class="eyebrow">{c.work.caseTitle}</p>
        <p class="muted">{c.work.caseText}</p>
      </article>
      <blockquote class="placeholder placeholder--block quote">
        <p>“{c.work.quote}”</p>
      </blockquote>
    </div>
  </div>
</section>

<!-- 05 Team -->
<section class="section section--surface" id="team" aria-labelledby="team-title">
  <div class="container">
    <SectionHead num="05" title={c.team.title} id="team-title">{c.team.intro}</SectionHead>
    <ul class="team" role="list">
      {site.team.map((m) => (
        <li class="member">
          {m.photo
            ? <img class="member__photo" src={m.photo} alt={m.name} width="800" height="1000" loading="lazy" decoding="async" />
            : <div class="member__photo placeholder">{c.team.photo}</div>}
          <p class="member__name">{m.linkedin ? <a href={m.linkedin} rel="noopener" target="_blank">{m.name}</a> : m.name}</p>
          <p class="small muted">{m.role[lang]}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<!-- 06 Contact -->
<section class="section section--band" id="contact" aria-labelledby="contact-title">
  <div class="container">
    <div class="contact">
      <div class="contact__main">
        <span class="section-head__num" aria-hidden="true">0 6</span>
        <h2 class="h2" id="contact-title">{c.contact.title}</h2>
        <p class="lead">{c.contact.lead}</p>
        <form class="contact-form" method="post" data-mailto={site.email} data-subject={c.contact.form.subject}
              action={site.formEndpoint || `mailto:${site.email}?subject=${encodeURIComponent(c.contact.form.subject)}`}
              enctype={site.formEndpoint ? undefined : 'text/plain'}>
          <div class="contact-form__row">
            <label class="field">
              <span class="field__label">{c.contact.form.name}</span>
              <input class="field__input" type="text" name="name" autocomplete="name" required />
            </label>
            <label class="field">
              <span class="field__label">{c.contact.form.email}</span>
              <input class="field__input" type="email" name="email" autocomplete="email" required />
            </label>
          </div>
          <label class="field">
            <span class="field__label">{c.contact.form.company} <span class="field__optional">{c.contact.form.optional}</span></span>
            <input class="field__input" type="text" name="company" autocomplete="organization" />
          </label>
          <label class="field">
            <span class="field__label">{c.contact.form.message}</span>
            <textarea class="field__input" name="message" rows="5" required></textarea>
          </label>
          <div class="contact-form__actions">
            <button class="btn btn--primary" type="submit">{c.contact.form.submit} <span class="arrow" aria-hidden="true">→</span></button>
            <p class="small muted">{c.contact.form.orWrite} <a href={`mailto:${site.email}`}>{site.email}</a></p>
          </div>
        </form>
      </div>
      <div class="contact__side callout">
        <p class="eyebrow">{c.contact.officesLabel}</p>
        <ul class="offices" role="list">
          {offices.map((o) => (
            <li>
              <strong>{o.countryName}</strong>
              <span class="small muted">{o.entity} · {o.city}</span>
            </li>
          ))}
        </ul>
        <p class="eyebrow">{c.contact.followLabel}</p>
        <SocialLinks />
      </div>
    </div>
  </div>
</section>

<script>
  // Without a form backend, compose a readable email in the visitor's mail app.
  document.querySelectorAll<HTMLFormElement>('form.contact-form[data-mailto]').forEach((form) => {
    if (!form.action.startsWith('mailto:')) return;
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const d = new FormData(form);
      const body = [
        `${d.get('name')} <${d.get('email')}>`,
        d.get('company') ? String(d.get('company')) : '',
        '',
        String(d.get('message') ?? ''),
      ].filter((l, i) => l !== '' || i === 2).join('\n');
      const subject = form.dataset.subject ?? '';
      window.location.href = `mailto:${form.dataset.mailto}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
    });
  });
</script>

<style>
  .hero { position: relative; overflow: hidden; padding-block: clamp(4rem, 3rem + 8vw, 9rem); }
  .hero__inner > * + * { margin-top: var(--space-6); }
  .hero__title { max-width: 13ch; }
  .hero__actions { display: flex; flex-wrap: wrap; gap: var(--space-3); }
  .hero__places { letter-spacing: 0.08em; }
  :global(.hero__leaf) { width: min(85vw, 620px); right: -14%; bottom: -30%; }
  @media (min-width: 64rem) { :global(.hero__leaf) { right: -4%; bottom: -18%; } }

  .services { row-gap: var(--space-7); }

  .team { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-6); grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr)); max-width: 40rem; }
  .member__photo { display: block; width: 100%; height: auto; aspect-ratio: 4 / 5; object-fit: cover; background: var(--color-surface); }
  .member__photo.placeholder { min-height: 0; }
  .member__name { margin-top: var(--space-4); font-family: var(--font-display); font-weight: 500; color: var(--color-ink); }
  .member__name a { color: inherit; text-decoration: none; }
  .member__name a:hover { color: var(--color-accent); }

  .logos { list-style: none; padding: 0; margin: 0 0 var(--space-6); display: grid; gap: var(--space-4); grid-template-columns: repeat(2, 1fr); }
  @media (min-width: 48rem) { .logos { grid-template-columns: repeat(4, 1fr); } }
  .placeholder {
    display: grid; place-items: center; min-height: 6rem; padding: var(--space-5);
    border: 1px dashed var(--color-taupe-strong); color: var(--color-faint);
    font-size: var(--text-sm); text-align: center;
  }
  .placeholder--block { place-items: start; align-content: start; gap: var(--space-2); min-height: 11rem; text-align: left; }
  .quote { margin: 0; font-family: var(--font-display); font-size: var(--text-xl); color: var(--color-muted); }

  .contact { display: grid; gap: var(--space-7); align-items: start; }
  .contact__main > * + * { margin-top: var(--space-5); }
  .contact-form { display: grid; gap: var(--space-5); margin-top: var(--space-6) !important; }
  .contact-form__row { display: grid; gap: var(--space-5); }
  @media (min-width: 40rem) { .contact-form__row { grid-template-columns: 1fr 1fr; } }
  .contact-form__actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-4); }
  .contact__side > * + * { margin-top: var(--space-4); }
  .contact__side .eyebrow { color: var(--color-ink-soft); }
  .contact__main .section-head__num { color: var(--color-accent); }
  .offices { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-3); padding-bottom: var(--space-3); }
  .offices li { display: flex; flex-direction: column; }
  @media (min-width: 56rem) { .contact { grid-template-columns: 1.4fr 1fr; gap: var(--space-9); } }
</style>
