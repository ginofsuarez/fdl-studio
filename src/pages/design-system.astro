---
import Base from '../layouts/Base.astro';
import SectionHead from '../components/SectionHead.astro';
import MapleLeaf from '../components/MapleLeaf.astro';
import Logo from '../components/Logo.astro';

const swatches = [
  ['--color-bg', 'Background'], ['--color-surface', 'Surface'], ['--color-band', 'Band'],
  ['--color-taupe', 'Taupe accent'], ['--color-taupe-strong', 'Taupe strong'],
  ['--color-ink', 'Ink'], ['--color-ink-soft', 'Body text'], ['--color-muted', 'Muted'],
  ['--color-faint', 'Faint'], ['--color-line', 'Line'],
];
---
<Base lang="en" title="Design system | FDL Studio" noindex>
  <!-- Cover -->
  <section class="section" style="overflow:hidden">
    <MapleLeaf style="width:min(60vw,560px); right:-6%; top:10%;" />
    <div class="container relative-content stack-lg">
      <p class="eyebrow">Design system · v0.1</p>
      <h1 class="display" style="max-width:12ch">FDL Studio visual language</h1>
      <p class="lead">Warm neutrals, near-black ink and a taupe accent. Poppins for headings, Inter for text. Generous whitespace, thin rules, numbered sections.</p>
      <div style="display:flex; gap:var(--space-4); flex-wrap:wrap">
        <a class="btn btn--primary" href="#colors">Primary action <span class="arrow">→</span></a>
        <a class="btn btn--ghost" href="#type">Secondary action</a>
      </div>
    </div>
  </section>

  <!-- 01 Colors -->
  <section class="section section--band" id="colors">
    <div class="container">
      <SectionHead num="01" title="Color">Tokens live in <code>src/styles/tokens.css</code>.</SectionHead>
      <div class="swatches">
        {swatches.map(([v, name]) => (
          <figure class="swatch">
            <div class="swatch__chip" style={`background:var(${v})`}></div>
            <figcaption><strong class="small">{name}</strong><br /><span class="caption">{v}</span></figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- 02 Type -->
  <section class="section" id="type">
    <div class="container stack-lg">
      <SectionHead num="02" title="Typography" />
      <p class="eyebrow">Eyebrow · F D L &nbsp;S T U D I O</p>
      <h1 class="display">Display — Poppins Bold</h1>
      <h2 class="h2">Heading 2 — section titles</h2>
      <h3 class="h3">Heading 3 — card and block titles</h3>
      <p class="lead">Lead — Inter 18px, muted. Introduces a section in one or two sentences.</p>
      <p style="max-width:40rem">Body — Inter 16px with a 1.65 line height. <strong>Bold inline</strong> for key terms, like the label-first lists in our documents. Links use a <a class="link-arrow" href="#">quiet underline →</a></p>
      <p class="caption">Caption — 12px, used for notes under tables.</p>
    </div>
  </section>

  <!-- 03 Cards -->
  <section class="section section--surface">
    <div class="container">
      <SectionHead num="03" title="Service cards">Three columns on desktop, stacked on mobile.</SectionHead>
      <div class="grid grid--3">
        <article class="card">
          <span class="card__code">01</span>
          <h3 class="h3">Oracle APEX applications</h3>
          <p class="muted small">Enterprise web applications built on the Oracle Database, from discovery to production.</p>
          <ul class="card__list"><li>Process digitalization</li><li>Legacy modernization</li></ul>
        </article>
        <article class="card">
          <span class="card__code">02</span>
          <h3 class="h3">Oracle Cloud &amp; operations</h3>
          <p class="muted small">Environments, monitoring, backups and CI/CD on OCI.</p>
          <ul class="card__list"><li>Managed environments</li><li>DevOps pipelines</li></ul>
        </article>
        <article class="card">
          <span class="card__code">03</span>
          <h3 class="h3">Applied AI</h3>
          <p class="muted small">AI features inside your applications, where accuracy matters.</p>
          <ul class="card__list"><li>Document processing</li><li>Assistants &amp; search</li></ul>
        </article>
      </div>
    </div>
  </section>

  <!-- 04 Steps -->
  <section class="section">
    <div class="container">
      <SectionHead num="04" title="Process steps" />
      <ol class="steps" style="--steps:4">
        <li class="step"><span class="step__dot">1</span><p class="step__title">Discover</p><p class="step__text">Understand the problem</p></li>
        <li class="step"><span class="step__dot">2</span><p class="step__title">Design</p><p class="step__text">Architecture and scope</p></li>
        <li class="step"><span class="step__dot">3</span><p class="step__title">Build</p><p class="step__text">Iterative delivery</p></li>
        <li class="step"><span class="step__dot">4</span><p class="step__title">Evolve</p><p class="step__text">Support and improvement</p></li>
      </ol>
    </div>
  </section>

  <!-- 05 Table + callout -->
  <section class="section section--band">
    <div class="container stack-lg">
      <SectionHead num="05" title="Table & callout" />
      <div class="table-wrap">
        <table class="table">
          <thead><tr><th>Capability</th><th>Stack</th><th class="num">Years</th></tr></thead>
          <tbody>
            <tr><td>Oracle APEX</td><td>APEX, PL/SQL, ORDS</td><td class="num">15+</td></tr>
            <tr><td>Oracle Cloud</td><td>OCI, Autonomous Database</td><td class="num">8+</td></tr>
            <tr><td>Applied AI</td><td>LLMs, document AI</td><td class="num">3+</td></tr>
          </tbody>
        </table>
      </div>
      <p class="caption">Sample data for layout only.</p>
      <div class="callout">
        <p class="callout__title">Let's talk about your project</p>
        <p>Taupe block for highlighted messages and calls to action.</p>
      </div>
      <p><span class="tag">Oracle APEX</span> <span class="tag">OCI</span> <span class="tag">PL/SQL</span></p>
    </div>
  </section>

  <!-- 06 Brand -->
  <section class="section">
    <div class="container stack-lg">
      <SectionHead num="06" title="Brand" />
      <Logo />
      <p class="caption">Official horizontal logo from the brand kit v1.0.</p>
    </div>
  </section>
</Base>

<style>
  code { font-size: 0.9em; background: var(--color-surface); padding: 0.1em 0.35em; border-radius: var(--radius-sm); }
  .swatches { display: grid; gap: var(--space-5); grid-template-columns: repeat(auto-fill, minmax(8.5rem, 1fr)); }
  .swatch { margin: 0; }
  .swatch__chip { height: 4.5rem; border: 1px solid var(--color-line); margin-bottom: var(--space-2); }
</style>
